{
  "manifest_version": 3,
  "name": "Claude Backup Organizer",
  "version": "0.3.0",
  "description": "Back up Claude conversations, search them, add tags/notes, preview, and export Markdown/CSV.",
  "permissions": [
    "downloads",
    "storage",
    "windows"
  ],
  "host_permissions": [
    "https://claude.ai/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup-simple.html",
    "default_title": "Claude Organizer"
  },
  "options_page": "options.html",
  "icons": {
    "128": "claude_backup_icon.png"
  }
}