{
  "manifest_version": 3,
  "name": "Claude Backup Organizer",
  "version": "0.3.0",
  "description": "Back up Claude conversations, search them, add tags/notes, preview, and export Markdown/CSV.",
  "permissions": [
    "downloads",
    "storage"
  ],
  "host_permissions": [
    "https://claude.ai/*"
  ],
  "background": {
    "service_worker": "claude-backup-organizer/background.js"
  },
  "action": {
    "default_popup": "claude-backup-organizer/popup.html",
    "default_title": "Claude Organizer"
  },
  "options_page": "claude-backup-organizer/options.html",
  "icons": {
    "128": "claude-backup-organizer/icon128.png"
  }
}

